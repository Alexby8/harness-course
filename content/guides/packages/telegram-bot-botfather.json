                          "marks": [
                            {
                              "type": "link",
                              "attrs": {
                                "href": "https://core.telegram.org/bots/tutorial",
                                "target": "_blank",
                                "rel": "noopener noreferrer"
                              }
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " — токен и подключение программы."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Введение в Telegram-ботов",
                          "marks": [
                            {
                              "type": "link",
                              "attrs": {
                                "href": "https://core.telegram.org/bots",
                                "target": "_blank",
                                "rel": "noopener noreferrer"
                              }
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " — устройство бота и отличие от аккаунта пользователя."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
