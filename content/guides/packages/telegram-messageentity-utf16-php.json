      {
        "id": "php-slice",
        "label": "Как вырезать диапазон в PHP",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "heading",
              "attrs": {
                "level": 2
              },
              "content": [
                {
                  "type": "text",
                  "text": "Как вырезать диапазон в PHP"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Перекодируйте исходную строку в "
                },
                {
                  "type": "text",
                  "text": "UTF-16LE",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ". В этой кодировке каждая кодовая единица занимает два байта. Умножьте "
                },
                {
                  "type": "text",
                  "text": "offset",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " и "
                },
                {
                  "type": "text",
                  "text": "length",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " на два и передайте их в "
                },
                {
                  "type": "text",
                  "text": "substr()",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ". Перекодируйте полученный фрагмент обратно в UTF-8. "
                },
                {
                  "type": "text",
                  "text": "Документация mb_convert_encoding()",
                  "marks": [
                    {
                      "type": "link",
                      "attrs": {
                        "href": "https://www.php.net/manual/ru/function.mb-convert-encoding.php",
                        "target": "_blank"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " и "
                },
                {
                  "type": "text",
                  "text": "substr()",
                  "marks": [
                    {
                      "type": "link",
                      "attrs": {
                        "href": "https://www.php.net/manual/ru/function.substr.php",
                        "target": "_blank"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Сохраните код в файл "
                },
                {
                  "type": "text",
                  "text": "entity-text.php",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " в UTF-8. JSON внутри файла содержит поля уже полученного обновления, нужные для разбора."
                }
              ]
            },
            {
              "type": "customBlock",
              "attrs": {
                "id": "guide-code",
                "config": {
                  "label": "entity-text.php",
                  "code": "<?php\n\ndeclare(strict_types=1);\n\nfunction entityText(string $text, int $offset, int $length): string\n{\n    $utf16 = mb_convert_encoding($text, 'UTF-16LE', 'UTF-8');\n    $fragment = substr($utf16, $offset * 2, $length * 2);\n\n    return mb_convert_encoding($fragment, 'UTF-8', 'UTF-16LE');\n}\n\n$json = <<<'JSON'\n{\n    \"message\": {\n        \"text\": \"😺 Привет @bot и 🚀 старт!\",\n        \"entities\": [\n            {\"type\": \"mention\", \"offset\": 10, \"length\": 4},\n            {\"type\": \"bold\", \"offset\": 17, \"length\": 8}\n        ]\n    }\n}\nJSON;\n\n$update = json_decode($json, true, 512, JSON_THROW_ON_ERROR);\n$message = $update['message'];\n\nforeach ($message['entities'] ?? [] as $entity) {\n    $fragment = entityText($message['text'], $entity['offset'], $entity['length']);\n\n    printf(\n        \"%s (offset=%d, length=%d) → %s\\n\",\n        $entity['type'],\n        $entity['offset'],\n        $entity['length'],\n        $fragment,\n    );\n}"
                }
              }
            }
          ]
        }
      },
