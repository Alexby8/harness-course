                }
              ]
            }
          ]
        }
      },
      {
        "id": "routing",
        "label": "Выбираем экран при запуске",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "heading",
              "attrs": {
                "level": 2
              },
              "content": [
                {
                  "type": "text",
                  "text": "Выбираем экран при запуске"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Для прямой ссылки Telegram передаёт значение как "
                },
                {
                  "type": "text",
                  "text": "start_param",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " в данных запуска и как "
                },
                {
                  "type": "text",
                  "text": "tgWebAppStartParam",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " для ранней настройки интерфейса. Например, по нему можно показать заголовок «Загружаем заказ» до входа. К значению из "
                },
                {
                  "type": "text",
                  "text": "initDataUnsafe",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " или URL относитесь как к подсказке интерфейса."
                }
              ]
            },
            {
              "type": "customBlock",
              "attrs": {
                "id": "guide-code",
                "config": {
                  "label": "JavaScript · выбор экрана",
                  "code": "function parseLaunchTarget(value) {\n  if (typeof value !== 'string') return { screen: 'catalog' };\n\n  const product = /^p_([a-z0-9]+(?:-[a-z0-9]+)*)$/.exec(value);\n  if (product && product[0] === value && product[1].length <= 48) {\n    return { screen: 'product', id: product[1] };\n  }\n\n  const order = /^o_([a-f0-9]{24})$/.exec(value);\n  if (order && order[0] === value) {\n    return { screen: 'order', id: order[1] };\n  }\n\n  return { screen: 'catalog' };\n}\n\nconst target = parseLaunchTarget(\n  window.Telegram?.WebApp?.initDataUnsafe?.start_param\n);"
                }
              }
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Подключите скрипт Telegram перед этим кодом. Маршрутизатор приложения получает один из трёх экранов. Для товара он запрашивает публичную карточку по slug. Для заказа он дожидается серверной сессии и запрашивает детали по ID. Для пустого или некорректного параметра открывается каталог. Валидная ссылка на снятый с продажи товар показывает сообщение «Товар недоступен» и предлагает вернуться в каталог."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Если сервер сам использует "
                },
                {
                  "type": "text",
                  "text": "start_param",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ", извлеките его из проверенной строки "
                },
                {
                  "type": "text",
                  "text": "initData",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " по правилам "
                },
                {
                  "type": "text",
                  "text": "авторизации Mini App",
                  "marks": [
                    {
                      "type": "link",
                      "attrs": {
                        "href": "/guides/telegram-mini-app-initdata-auth-php-laravel"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ". Даже в подписанных данных параметр отражает ссылку, по которой перешёл пользователь. Проверка подписи подтверждает личность, а право открыть конкретный заказ проверяется отдельно."
                }
              ]
            }
          ]
        }
      },
      {
        "id": "order-access",
        "label": "Проверяем владельца заказа на сервере",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "heading",
              "attrs": {
                "level": 2
              },
              "content": [
                {
                  "type": "text",
                  "text": "Проверяем владельца заказа на сервере"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Обработчик "
                },
                {
                  "type": "text",
                  "text": "GET /api/orders/{public_id}",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " получает владельца из сессии. После входа по "
                },
                {
                  "type": "text",
                  "text": "initData",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " это может быть проверенный Telegram ID либо ID аккаунта сайта, к которому он подтверждённо привязан. Возвращайте только поля, нужные для показа заказа."
                }
              ]
            },
            {
              "type": "customBlock",
              "attrs": {
                "id": "guide-code",
                "config": {
                  "label": "SQL · выборка для авторизованного пользователя",
                  "code": "SELECT public_id, status, total_minor\nFROM orders\nWHERE public_id = :public_id\n  AND telegram_user_id = :session_telegram_user_id;"
                }
              }
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Передавайте параметры через подготовленный запрос. Без сессии верните "
                },
                {
                  "type": "text",
                  "text": "401",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ". Для чужого и отсутствующего заказа верните одинаковый "
                },
                {
                  "type": "text",
                  "text": "404",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ". У защищённых ответов установите "
                },
                {
                  "type": "text",
                  "text": "Cache-Control: private, no-store",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ". Ту же проверку владельца примените к деталям, действиям с заказом и скачиванию документов."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Если ссылку перешлют, у получателя откроется Mini App. Его сессия подтвердит другой аккаунт, и сервер не выдаст заказ. Случайный ID снижает возможность перебора, а ограничение выборки по владельцу защищает саму запись. Про её создание и сохранение цены читайте в "
                },
                {
                  "type": "text",
                  "text": "руководстве по оформлению заказа",
                  "marks": [
                    {
                      "type": "link",
                      "attrs": {
                        "href": "/guides/telegram-mini-app-cart-checkout"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            }
          ]
        }
      },
      {
        "id": "working-screen",
        "label": "Загружаем и показываем выбранный экран",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "heading",
              "attrs": {
                "level": 2
              },
              "content": [
                {
                  "type": "text",
                  "text": "Загружаем и показываем выбранный экран"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Соединим маршрутизатор с запросами. Для примера используем Laravel, вход "
                },
                {
                  "type": "text",
                  "text": "loginMiniApp()",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " из статьи об авторизации и таблицу orders из примера корзины. В ней есть public_id, telegram_user_id, status и total_minor. Добавьте "
                },
                {
                  "type": "text",
                  "text": "<main id=\"screen\" aria-live=\"polite\"></main>",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " на Blade-страницу. Подключите функцию входа и parseLaunchTarget раньше следующего кода."
                }
              ]
            },
            {
              "type": "customBlock",
              "attrs": {
                "id": "guide-code",
                "config": {
                  "label": "JavaScript · запуск после загрузки страницы",
                  "code": "async function showLaunchScreen(target = parseLaunchTarget(window.Telegram?.WebApp?.initDataUnsafe?.start_param)) {\n  const screen = document.querySelector('#screen');\n  screen.replaceChildren();\n  const title = document.createElement('h1');\n  const details = document.createElement('p');\n  screen.append(title, details);\n  try {\n    if (target.screen === 'catalog') {\n      title.textContent = 'Каталог';\n      details.textContent = 'Выберите товар в каталоге магазина.';\n      return;\n    }\n    title.textContent = target.screen === 'order' ? 'Загружаем заказ' : 'Загружаем товар';\n    if (target.screen === 'order') await loginMiniApp();\n    const url = target.screen === 'order' ? '/mini/orders/' : '/mini/products/';\n    const response = await fetch(url + encodeURIComponent(target.id), {\n      credentials: 'same-origin', headers: {'Accept': 'application/json'}, cache: 'no-store'\n    });\n    if (response.status === 404) {\n      title.textContent = 'Данные недоступны';\n      details.textContent = 'Проверьте ссылку или вернитесь в каталог.';\n      return;\n    }\n    if (response.status === 401) throw new Error('Переоткройте приложение для входа');\n    if (!response.ok) throw new Error('Не удалось загрузить данные. Повторите позже');\n    const data = await response.json();\n    const money = new Intl.NumberFormat('ru-RU', {style: 'currency', currency: 'RUB'});\n    title.textContent = target.screen === 'order' ? 'Заказ ' + data.public_id : data.title;\n    details.textContent = target.screen === 'order'\n      ? 'Статус: ' + data.status + '. Сумма: ' + money.format(data.total_minor / 100)\n      : money.format(data.price_minor / 100);\n  } catch (error) {\n    title.textContent = 'Не удалось открыть экран';\n    details.textContent = error instanceof Error ? error.message : 'Повторите открытие';\n  } finally {\n    if (target.screen !== 'catalog') {\n      const back = document.createElement('button');\n      back.type = 'button';\n      back.textContent = 'Вернуться в каталог';\n      back.addEventListener('click', () => showLaunchScreen({screen: 'catalog'}));\n      screen.append(back);\n    }\n    window.Telegram?.WebApp?.ready();\n  }\n}\nshowLaunchScreen();"
                }
              }
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Серверные маршруты находятся в "
                },
                {
                  "type": "text",
                  "text": "routes/web.php",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ", чтобы использовать ту же сессию, что и вход. Публичный товар ниже задан массивом для воспроизводимого примера; замените его выборкой своего каталога с признаком доступности. Заказ выбирается только из БД и только для владельца."
                }
              ]
            },
            {
              "type": "customBlock",
              "attrs": {
                "id": "guide-code",
                "config": {
                  "label": "PHP · маршруты карточки и заказа",
                  "code": "use Illuminate\\Http\\Request;\nuse Illuminate\\Support\\Facades\\DB;\nuse Illuminate\\Support\\Facades\\Route;\n\nRoute::get('/mini/products/{slug}', function (string $slug) {\n    $catalog = ['green-tea' => ['title' => 'Зелёный чай', 'price_minor' => 45000]];\n    abort_unless(isset($catalog[$slug]), 404);\n    return response()->json($catalog[$slug]);\n})->where('slug', '[a-z0-9-]{1,48}')->middleware('throttle:60,1');\n\nRoute::get('/mini/orders/{id}', function (Request $request, string $id) {\n    $owner = $request->session()->get('mini_user_id');\n    abort_unless(is_int($owner) && (int) $request->session()->get('mini_expires_at', 0) > time(), 401);\n    $order = DB::table('orders')->where('public_id', $id)->where('telegram_user_id', $owner)\n        ->first(['public_id', 'status', 'total_minor']);\n    abort_if(!$order, 404);\n    return response()->json($order)->header('Cache-Control', 'private, no-store');\n})->where('id', '[a-f0-9]{24}')->middleware('throttle:60,1');"
                }
              }
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "В этом примере используется префикс "
                },
                {
                  "type": "text",
                  "text": "/mini",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ]
                },
                {
                  "type": "text",
