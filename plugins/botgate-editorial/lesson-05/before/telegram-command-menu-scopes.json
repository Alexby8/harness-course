              "marks": [
                {
                  "type": "code"
                }
              ],
              "type": "text",
              "text": "/rules"
            },
            {
              "type": "text",
              "text": " для просмотра правил. Для этого задайте отдельный список команд для каждого типа чата."
            }
          ]
